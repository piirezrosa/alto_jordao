# Copie para ".env" na RAIZ do projeto (ao lado do docker-compose.yml). Nunca vai para o GitHub.
WEB_PORT=8080
SITE_URL=http://localhost:8080

# Banco (o serviço "db" é criado com estes valores)
DB_ROOT_PASS=troque-esta-senha-root
DB_NAME=alto_jordao
