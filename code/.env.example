# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores reais.
# O ".env" NUNCA vai para o GitHub (está no .gitignore). Este ".env.example" vai, só com exemplos.

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alto_jordao
DB_USER=root
DB_PASS=

# URL do site (usada em redirects e webhooks)
SITE_URL=http://localhost/alto_jordao/code

# PagBank / PagSeguro
PS_SANDBOX=true
PS_TOKEN=
PS_PUBLIC_KEY=

# Mercado Pago
MP_SANDBOX=true
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Chave para rodar a análise de alertas por URL (opcional; sem ela só roda pelo terminal/painel)
ALERTAS_CHAVE=
