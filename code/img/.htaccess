# Pasta de imagens enviadas: nunca executar código aqui, só servir imagens.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml|inc)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
Options -Indexes
